# Required only for future live Composio catalog/toolkit operations.
COMPOSIO_API_KEY=

# Local paths are relative to the repository root unless absolute.
DATA_DIR=data
OUTPUT_DIR=output

# Keep networked work bounded when research and verification are implemented.
CONCURRENCY=

# Optional: set this to resume a specific immutable run directory.
RESEARCH_RUN_ID=
RESEARCH_MAX_RETRIES=

# ESM module (relative to this repository or absolute) exporting either a
# default StructuredResearchResultGenerator or a named `resultGenerator`.

RESEARCH_RESULT_GENERATOR_MODULE=